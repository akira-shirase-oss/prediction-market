# The server's environment: one KEY=value per line, comments on their own lines only
# (systemd's EnvironmentFile keeps `KEY=value # note` as part of the value). Install it as
# /etc/predict/env, root-owned, mode 0644: it holds no secret. Every variable is checked at
# startup; one out of bounds stops the server with every problem listed.
#
# Each line shows the default. A test (crates/predict-server/src/config.rs) keeps this
# file and the code in step: a variable added there must be added here.

# --- Listening and connection bounds (crates/predict-http/src/serve.rs) ---------------
# Loopback only: Caddy terminates TLS in front (deploy/Caddyfile).
# PREDICT_LISTEN=127.0.0.1:63150
# A request head must arrive within this; also the idle timeout of keep-alive connections.
# PREDICT_HEADER_READ_TIMEOUT_MS=10000
# Connections served at once; past it they wait in the listen backlog. Keep it below the
# unit's LimitNOFILE (deploy/predict.service) less the pool and some headroom.
# PREDICT_MAX_CONNECTIONS=512
# A response write that makes no progress for this long closes its connection.
# PREDICT_WRITE_STALL_MS=10000
# The answer to this many requests on one connection says Connection: close.
# PREDICT_MAX_REQUESTS_PER_CONNECTION=1000
# A connection older than this finishes its request in flight and closes.
# PREDICT_CONNECTION_MAX_AGE_MS=600000
# How long an aged connection may take to finish (at least the request timeout).
# PREDICT_REQUEST_GRACE_MS=10000
# How long shutdown waits for open connections; keep it below TimeoutStopSec.
# PREDICT_DRAIN_TIMEOUT_MS=15000

# --- Requests (crates/predict-http/src/stack.rs) --------------------------------------
# The whole request, body included; past it 503.
# PREDICT_REQUEST_TIMEOUT_MS=5000
# PREDICT_MAX_BODY_BYTES=65536
# /v1 requests running at once; past it 503 overloaded at once.
# PREDICT_MAX_IN_FLIGHT=64

# --- Database (crates/predict-db) ------------------------------------------------------
# PREDICT_DB_MAX_CONNECTIONS=16
# PREDICT_DB_ACQUIRE_TIMEOUT_MS=2000
# PREDICT_DB_STATEMENT_TIMEOUT_MS=3000
# The /readyz probe's deadline.
# PREDICT_READY_TIMEOUT_MS=500
# How long startup waits for an unavailable database before giving up.
# PREDICT_STARTUP_TIMEOUT_MS=30000

# --- Health and logs -------------------------------------------------------------------
# /errorz answers 503 when server errors exceed this many per thousand requests over five
# minutes, once at least PREDICT_ERROR_MIN_REQUESTS were answered.
# PREDICT_ERROR_RATE_PERMILLE=50
# PREDICT_ERROR_MIN_REQUESTS=20
# PREDICT_LOG=info
# json for journald; text for a terminal.
# PREDICT_LOG_FORMAT=json

# --- Accounts (crates/predict-accounts) ------------------------------------------------
# A loopback SMTP relay (the local MTA that relays onward over TLS). Empty disables mail.
# PREDICT_SMTP_RELAY=
# PREDICT_MAIL_FROM=noreply@prediction-market.invalid
# Where links in emails point.
# PREDICT_PUBLIC_URL=http://127.0.0.1:63150
# PREDICT_COOKIE_SECURE=true
# PREDICT_SESSION_TTL_S=604800
# PREDICT_SESSION_IDLE_S=86400
# Caddy on this host is 127.0.0.1: then budgets key on the client, not on Caddy.
# PREDICT_TRUSTED_PROXIES=
# PREDICT_PASSWORD_CONCURRENCY=2
# The free plan's limits (payments are bypassed).
# PREDICT_PLAN_MAX_MEMBERS=10
# PREDICT_PLAN_MAX_TOKENS=10
# PREDICT_PLAN_MAX_OWNED_WORKSPACES=3

# --- Secrets: never in this file ------------------------------------------------------
# The unit loads them as systemd credentials (LoadCredential=, files under
# /etc/predict/credentials, root:root 0600); the server reads $CREDENTIALS_DIRECTORY/<name>.
# Outside systemd, point a _FILE variable at an owner-only file instead:
#   database-url            the server, as the runtime role predict_app
#   migration-database-url  predictctl migrate, digests, fingerprint, prune-events (predict_owner)
#   admin-database-url      predictctl bootstrap only
#   owner-password          predictctl bootstrap only
#   app-password            predictctl bootstrap only
# PREDICT_DATABASE_URL_FILE=/etc/predict/credentials/database-url
# PREDICT_MIGRATION_DATABASE_URL_FILE=/etc/predict/credentials/migration-database-url
# PREDICT_ADMIN_DATABASE_URL_FILE=/etc/predict/credentials/admin-database-url
# PREDICT_OWNER_PASSWORD_FILE=/etc/predict/credentials/owner-password
# PREDICT_APP_PASSWORD_FILE=/etc/predict/credentials/app-password
